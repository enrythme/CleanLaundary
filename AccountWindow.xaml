<Window x:Class="LaundryPractice.AccountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Title="Регистрация" Width="470" SizeToContent="Height" ResizeMode="NoResize">
  <StackPanel Margin="30">
    <TextBlock x:Name="HeadingText" Text="Регистрация" Style="{StaticResource Heading}"/>
    <StackPanel x:Name="RegistrationFields">
      <TextBlock Text="Логин"/><TextBox x:Name="LoginInput" Tag="Например: client" MaxLength="40" ToolTip="3–40 латинских букв, цифр, точек, дефисов и подчёркиваний"/>
      <TextBlock Text="ФИО"/><TextBox x:Name="NameInput" Tag="Фамилия Имя Отчество" MaxLength="100" ToolTip="2–100 букв, пробелов, дефисов и апострофов"/>
      <TextBlock Text="Электронная почта"/><TextBox x:Name="EmailInput" Tag="name@example.ru" MaxLength="150" ToolTip="Введите полный адрес электронной почты"/>
    </StackPanel>
    <StackPanel x:Name="OldPasswordFields" Visibility="Collapsed"><TextBlock Text="Текущий пароль"/><PasswordBox x:Name="OldPasswordInput" Tag="Текущий пароль" ToolTip="Пароль, который используется сейчас"/></StackPanel>
    <TextBlock Text="Новый пароль"/><PasswordBox x:Name="PasswordInput" Tag="Не менее 8 символов" ToolTip="8–64 символа, хотя бы одна буква и одна цифра"/>
    <TextBlock Text="Повторите пароль"/><PasswordBox x:Name="RepeatInput" Tag="Повторите новый пароль" ToolTip="Должен совпадать с новым паролем"/>
    <TextBlock x:Name="Hint" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
    <WrapPanel HorizontalAlignment="Right">
      <Button x:Name="SaveButton" Content="Зарегистрироваться" IsDefault="True" Click="Save" ToolTip="Проверить поля и сохранить учётную запись"/>
      <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" ToolTip="Закрыть форму без сохранения"/>
    </WrapPanel>
  </StackPanel>
</Window>
