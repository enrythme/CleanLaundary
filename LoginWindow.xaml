<Window x:Class="LaundryPractice.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Title="Авторизация" Width="460" SizeToContent="Height" ResizeMode="NoResize" Closing="OnClosing">
  <StackPanel Margin="32">
    <TextBlock Text="Химчистки и прачечные" Style="{StaticResource Heading}"/>
    <TextBlock Text="Вход в систему" Margin="0,0,0,18"/>
    <TextBlock Text="Логин"/>
    <TextBox x:Name="LoginInput" Tag="Введите логин" ToolTip="3–40 латинских букв, цифр, точек, дефисов или подчёркиваний" MaxLength="40" TextChanged="LoginChanged"/>
    <TextBlock Text="Пароль"/>
    <PasswordBox x:Name="PasswordInput" Tag="Введите пароль" ToolTip="Пароль вашей учётной записи"/>
    <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed" Margin="0,2,0,8">
      <TextBlock Text="После трёх ошибок требуется капча" Margin="0,0,0,8"/>
      <Image x:Name="CaptchaPicture" Width="220" Height="64" HorizontalAlignment="Left" ToolTip="Введите пять символов с изображения"/>
      <TextBox x:Name="CaptchaInput" MaxLength="5" Tag="Код с изображения" ToolTip="Пять латинских букв или цифр. Регистр не важен"/>
      <Button Content="Обновить капчу" Click="RefreshCaptcha" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" ToolTip="Показать новый код"/>
    </StackPanel>
    <TextBlock x:Name="Hint" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,10"/>
    <WrapPanel HorizontalAlignment="Center">
      <Button x:Name="LoginButton" Content="Войти" IsDefault="True" Click="SignIn" ToolTip="Войти под выбранной учётной записью"/>
      <Button Content="Регистрация" Click="Register" Style="{StaticResource SecondaryButton}" ToolTip="Создать учётную запись пользователя"/>
    </WrapPanel>
    <Button Content="Выход" Click="Exit" HorizontalAlignment="Center" Style="{StaticResource SecondaryButton}" ToolTip="Закрыть приложение с подтверждением"/>
  </StackPanel>
</Window>
