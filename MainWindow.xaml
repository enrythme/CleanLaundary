<Window x:Class="LaundryPractice.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Title="Заказы" Width="1280" Height="850" MinWidth="1100" MinHeight="720" Closing="OnClosing">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Химчистки и прачечные" Style="{StaticResource Heading}"/><TextBlock x:Name="UserText" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center">
        <Button Content="Сменить пароль" Click="Password" ToolTip="Изменить пароль своей учётной записи" Style="{StaticResource SecondaryButton}"/>
        <Button Content="Сменить тему" Click="Theme" ToolTip="Настройка сохранится после выхода из учётной записи" Style="{StaticResource SecondaryButton}"/>
        <Button Content="Выйти из аккаунта" Click="Logout" ToolTip="Вернуться к авторизации" Style="{StaticResource SecondaryButton}"/>
      </WrapPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,14,0,2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><TextBlock Text="Раздел"/><ComboBox x:Name="SectionInput" SelectionChanged="SectionChanged" ToolTip="Выберите таблицу"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Поиск"/><TextBox x:Name="SearchInput" Tag="Поиск по всем полям" MaxLength="100" TextChanged="FilterChanged" ToolTip="Поиск без учёта регистра по видимым столбцам"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock x:Name="FilterLabel" Text="Статус"/><ComboBox x:Name="FilterInput" SelectionChanged="FilterChanged" ToolTip="Оставить записи с выбранным значением"/></StackPanel>
      <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Сортировать по"/><ComboBox x:Name="SortInput" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="FilterChanged" ToolTip="Столбец для сортировки"/></StackPanel>
      <StackPanel Grid.Column="4" Margin="0,0,10,0"><TextBlock Text="Порядок"/><ComboBox x:Name="DirectionInput" SelectedIndex="0" SelectionChanged="FilterChanged" ToolTip="Направление сортировки"><ComboBoxItem Content="По возрастанию"/><ComboBoxItem Content="По убыванию"/></ComboBox></StackPanel>
      <Button Grid.Column="5" Content="Обновить" Click="Refresh" VerticalAlignment="Center" ToolTip="Повторно загрузить записи из базы"/>
    </Grid>
    <WrapPanel x:Name="AdminActions" Grid.Row="2" Margin="0,0,0,10">
      <Button Content="Добавить" Click="Add" ToolTip="Добавить запись в выбранный раздел"/>
      <Button x:Name="EditButton" Content="Редактировать" Click="Edit" IsEnabled="False" ToolTip="Изменить выбранную запись"/>
      <Button x:Name="DeleteButton" Content="Удалить" Click="Delete" IsEnabled="False" ToolTip="Удалить запись и связанные заказы после подтверждения"/>
      <Button Content="Экспорт DOCX" Tag="docx" Click="Export" ToolTip="Сохранить текущие результаты в документ Word" Style="{StaticResource SecondaryButton}"/>
      <Button Content="Экспорт PDF" Tag="pdf" Click="Export" ToolTip="Сохранить текущие результаты в PDF" Style="{StaticResource SecondaryButton}"/>
      <Button Content="Экспорт XLSX" Tag="xlsx" Click="Export" ToolTip="Сохранить текущие результаты в книгу Excel" Style="{StaticResource SecondaryButton}"/>
    </WrapPanel>
    <DataGrid x:Name="Records" Grid.Row="3" AutoGeneratingColumn="GenerateColumn" SelectionChanged="SelectionChanged" MouseDoubleClick="DoubleClick" ToolTip="Выберите строку. Заголовок столбца также меняет сортировку"/>
    <Border x:Name="ChartPanel" Grid.Row="4" Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="14" Margin="0,12,0,0">
      <StackPanel><TextBlock Text="Количество заказов по статусам" FontWeight="SemiBold" Margin="0,0,0,8"/><StackPanel x:Name="ChartBars" Orientation="Horizontal"/></StackPanel>
    </Border>
    <TextBlock x:Name="ResultText" Grid.Row="5" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
  </Grid>
</Window>
